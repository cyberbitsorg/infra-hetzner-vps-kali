hcloud_token       = "your-api-token"
wg_peer_public_key = "REPLACE_WITH_MAC_WG_PUBLIC_KEY"
base_domain        = "your-domain.com"

servers = {
  fsn-kali01 = {
    server_type     = "cx33"
    server_location = "fsn1"
